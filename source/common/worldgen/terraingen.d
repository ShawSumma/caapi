module common.worldgen.terraingen;

import core.stdc.math : floorf;
import common.material : Material;

enum float TERRAIN_SURFACE_THICKNESS = 0.2f;
enum float DEEP_ELEVATION = -30.0f;
enum float LOW_ELEVATION = -12.0f;
enum float MEDIUM_ELEVATION = 2.0f;
enum float LATTICE_EDGE = 10.5f;
enum float LATTICE_SPACING = 1.5f;
enum int LATTICE_LAST_LINE = 14;
enum uint EVEN_ROW_POINTS = 8;
enum uint ODD_ROW_POINTS = 7;
enum uint LATTICE_POINTS = 113;
enum int NEAREST_SEARCH_REACH = 2;
enum float TEST_QUERY_EXTENT = 20.0f;
enum float TEST_QUERY_STEP = 0.13f;
enum float TEST_TIE_STEP = 0.75f;

Material terraingenVoronoi(float elevation, float rain, float temperature, float distance) {
    return materialTable(elevation, distance)[nearestLatticePoint(rain, temperature)];
}

const(Material)[] materialTable(float elevation, float distance) {
    if (distance <= TERRAIN_SURFACE_THICKNESS) {
        if (elevation < DEEP_ELEVATION) {
            return SURFACE_DEEP[];
        } else if (elevation < LOW_ELEVATION) {
            return SURFACE_LOW[];
        } else if (elevation < MEDIUM_ELEVATION) {
            return SURFACE_MED[];
        } else {
            return SURFACE_HIGH[];
        }
    } else {
        if (elevation < DEEP_ELEVATION) {
            return GENERAL_DEEP[];
        } else if (elevation < LOW_ELEVATION) {
            return GENERAL_LOW[];
        } else if (elevation < MEDIUM_ELEVATION) {
            return GENERAL_MED[];
        } else {
            return GENERAL_HIGH[];
        }
    }
}

float[2] latticeLocation(int row, int column) {
    float[2] result = [
        LATTICE_EDGE - LATTICE_SPACING * cast(float) row,
        -LATTICE_EDGE + LATTICE_SPACING * cast(float) column,
    ];
    return result;
}

uint latticeIndex(int row, int column) {
    return cast(uint)((row + 1) / 2) * EVEN_ROW_POINTS + cast(uint)(row / 2) * ODD_ROW_POINTS + cast(uint)(column / 2);
}

int clampLine(int line) {
    if (line < 0) {
        return 0;
    } else if (line > LATTICE_LAST_LINE) {
        return LATTICE_LAST_LINE;
    } else {
        return line;
    }
}

uint nearestLatticePoint(float rain, float temperature) {
    int centerRow = clampLine(cast(int) floorf((LATTICE_EDGE - rain) / LATTICE_SPACING + 0.5f));
    int centerColumn = clampLine(cast(int) floorf((temperature + LATTICE_EDGE) / LATTICE_SPACING + 0.5f));
    uint best = 0;
    float bestDistanceSquared = float.infinity;
    foreach (row; clampLine(centerRow - NEAREST_SEARCH_REACH) .. clampLine(centerRow + NEAREST_SEARCH_REACH) + 1) {
        foreach (column; clampLine(centerColumn - NEAREST_SEARCH_REACH) .. clampLine(centerColumn + NEAREST_SEARCH_REACH) + 1) {
            if ((row + column) % 2 == 0) {
                float[2] location = latticeLocation(row, column);
                float distanceSquared = sqr(location[0] - rain) + sqr(location[1] - temperature);
                if (distanceSquared <= bestDistanceSquared) {
                    bestDistanceSquared = distanceSquared;
                    best = latticeIndex(row, column);
                }
            }
        }
    }
    return best;
}

float sqr(float x) {
    return x * x;
}

unittest {
    uint bruteForceNearest(float rain, float temperature) {
        uint best = 0;
        float bestDistanceSquared = float.infinity;
        foreach (row; 0 .. LATTICE_LAST_LINE + 1) {
            foreach (column; 0 .. LATTICE_LAST_LINE + 1) {
                if ((row + column) % 2 == 0) {
                    float[2] location = latticeLocation(row, column);
                    float distanceSquared = sqr(location[0] - rain) + sqr(location[1] - temperature);
                    if (distanceSquared <= bestDistanceSquared) {
                        bestDistanceSquared = distanceSquared;
                        best = latticeIndex(row, column);
                    }
                }
            }
        }
        return best;
    }
    uint index = 0;
    foreach (row; 0 .. LATTICE_LAST_LINE + 1) {
        foreach (column; 0 .. LATTICE_LAST_LINE + 1) {
            if ((row + column) % 2 == 0) {
                assert(latticeIndex(row, column) == index);
                index += 1;
            }
        }
    }
    assert(index == LATTICE_POINTS);
    float rain = -TEST_QUERY_EXTENT;
    while (rain <= TEST_QUERY_EXTENT) {
        float temperature = -TEST_QUERY_EXTENT;
        while (temperature <= TEST_QUERY_EXTENT) {
            assert(nearestLatticePoint(rain, temperature) == bruteForceNearest(rain, temperature));
            temperature += TEST_QUERY_STEP;
        }
        rain += TEST_QUERY_STEP;
    }
    foreach (tieRow; -4 .. 33) {
        foreach (tieColumn; -4 .. 33) {
            float tieRain = LATTICE_EDGE - TEST_TIE_STEP * cast(float) tieRow;
            float tieTemperature = -LATTICE_EDGE + TEST_TIE_STEP * cast(float) tieColumn;
            assert(nearestLatticePoint(tieRain, tieTemperature) == bruteForceNearest(tieRain, tieTemperature));
        }
    }
}

