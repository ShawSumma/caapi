module common.geometry;

import std.math : sqrt, acosh, cosh, sinh;
import common.math : Matrix4, MVector;

/// The world is the order-5 cubic honeycomb {4,3,5}: cubic cells, 5 around each
/// edge. Crossing a cube face translates into the neighbor cube; composing those
/// translations as you walk builds the tiling.

enum int FACES = 6;

/// Face index -> (axis 0..2, sign -1/+1).
immutable int[2][FACES] FACE_AXIS_SIGN = [
    [0, -1], [0, +1],
    [1, -1], [1, +1],
    [2, -1], [2, +1],
];

/// The face you exit a neighbor through, given the face you entered it by.
immutable int[FACES] OPPOSITE = [1, 0, 3, 2, 5, 4];

// 5 cubes around an edge => dihedral angle 2*pi/5 = 72 deg. For a cube with
// faces as mirror planes at hyperbolic in-radius t, adjacent face normals give
// cos(dihedral) = sinh^2(t). So sinh^2(t) = cos(72 deg); 2t is the center-to-
// center distance and the boost magnitude for crossing a face.
private enum double SINH2_T = 0.30901699437494742;
private enum double COSH_2T = 1.6180339887498949;
private enum double SINH_2T = 1.2720196495140690;

/// Isometry for crossing `face` into the neighbor cube: the reflection across
/// that face's mirror plane (at hyperbolic distance t along the face normal).
/// The {4,3,5} honeycomb is the Coxeter group generated by these six face
/// reflections, so reflecting is what makes the cells close correctly (5 around
/// each edge). The reflection negates the face axis and boosts it by 2t.
Matrix4 faceTransform(int face) {
    int axis = FACE_AXIS_SIGN[face][0];
    int sign = FACE_AXIS_SIGN[face][1];
    Matrix4 m = Matrix4.identity();
    m.data[axis][axis] = cast(float)(-COSH_2T);
    m.data[3][axis] = cast(float)(sign * SINH_2T);
    m.data[axis][3] = cast(float)(-sign * SINH_2T);
    m.data[3][3] = cast(float) COSH_2T;
    return m;
}

unittest {
    import std.math : abs, sqrt, asinh, cosh, sinh, cos, PI;

    // The constants are the {4,3,5} values, derived not guessed.
    double t = asinh(sqrt(cos(72.0 * PI / 180.0)));
    assert(abs(cosh(2 * t) - COSH_2T) < 1e-9);
    assert(abs(sinh(2 * t) - SINH_2T) < 1e-9);
}

unittest {
    import std.math : abs;
    import common.math : hyperbolicDistance, Matrix4;

    // Crossing a face moves the cube center by the center-to-center distance 2t.
    MVector origin = MVector.origin();
    foreach (face; 0 .. FACES) {
        MVector moved = (faceTransform(face) * origin).normalized();
        double d = hyperbolicDistance(origin, moved);
        assert(abs(d - 2.0 * 0.5306375309525178) < 1e-4);
    }

    // A reflection is an involution: applying the same face crossing twice (its
    // own inverse) returns to the origin.
    foreach (face; 0 .. FACES) {
        MVector back = (faceTransform(face) * faceTransform(face) * origin).normalized();
        assert(hyperbolicDistance(origin, back) < 1e-4);
    }
}
