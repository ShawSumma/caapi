#version 450

#include "surface-extraction/surface.h"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) restrict uniform Parameters {
    int dimension;
};

layout(set = 1, binding = 0) readonly restrict buffer Voxels {
    uint voxel_pair[];
};

layout(set = 1, binding = 1) restrict buffer State {
    uint face_count;
};

layout(set = 1, binding = 2) writeonly restrict buffer Indirect {
    uint vertex_count;
    uint instance_count;
    uint first_vertex;
    uint first_instance;
};

layout(set = 1, binding = 3) writeonly restrict buffer Surfaces {
    Surface surfaces[];
};

struct Face {
    ivec3 voxel;
    uint axis;
    bool inward;
    uint material;
    bool valid;
};

ivec3 neighbor_offset(uint axis) {
    ivec3 off = ivec3(0);
    off[axis] = -1;
    return off;
}

uint get_voxel(ivec3 coords) {
    int stride = dimension + 2;
    int index = (coords.x + 1) + (coords.y + 1) * stride + (coords.z + 1) * stride * stride;
    uint pair = voxel_pair[index / 2];
    if (index % 2 == 0) {
        return pair & 0xFFFFu;
    }
    return pair >> 16;
}

Face find_face() {
    Face info;
    info.valid = false;
    info.voxel = ivec3(gl_GlobalInvocationID.x / 3, gl_GlobalInvocationID.yz);
    info.axis = gl_GlobalInvocationID.x % 3;

    ivec3 neighbor = info.voxel + neighbor_offset(info.axis);
    bool voxel_past_end = any(greaterThanEqual(info.voxel, ivec3(dimension)));
    bool neighbor_past_end = any(greaterThanEqual(neighbor, ivec3(dimension)));
    if (voxel_past_end && neighbor_past_end) {
        return info;
    }

    uint neighbor_mat = get_voxel(neighbor);
    uint self_mat = get_voxel(info.voxel);
    info.inward = self_mat == 0;
    info.material = self_mat | neighbor_mat;

    bool empty_past_far_edge = self_mat == 0 && info.voxel[info.axis] == dimension;
    bool empty_past_near_edge = neighbor_mat == 0 && neighbor[info.axis] == -1;
    if (empty_past_far_edge || empty_past_near_edge) {
        return info;
    }

    info.valid = (neighbor_mat == 0) != (self_mat == 0);
    return info;
}

// Per-corner ambient occlusion for a voxel face.
//
// Derived from the vertex shader geometry: voxels.vert maps the first texture
// coordinate to axis plus one and the second to axis plus two, and
// get_occlusion indexes corners as the first bit or the second shifted up, so
// the four corners are the plus and minus combinations of those two axes.
//
// For each corner we sample the three neighbouring voxels sharing it on the
// viewer side, which is the empty one: two edge-adjacent and one diagonal.
uvec4 surface_occlusion(ivec3 voxel, uint axis, bool inward) {
    ivec3 base = voxel;
    if (!inward) {
        base[axis] = base[axis] - 1;
    }

    uint b_axis = (axis + 1u) % 3u;
    uint c_axis = (axis + 2u) % 3u;

    uvec4 ao;
    for (uint i = 0u; i < 4u; i = i + 1u) {
        // Corner index is the b step in bit zero and the c step in bit one,
        // each mapping zero to minus one and one to plus one.
        int sb = int(i & 1u) * 2 - 1;
        int sc = int(i >> 1u) * 2 - 1;

        ivec3 edge_b = base;
        edge_b[b_axis] = edge_b[b_axis] + sb;

        ivec3 edge_c = base;
        edge_c[c_axis] = edge_c[c_axis] + sc;

        ivec3 diag = base;
        diag[b_axis] = diag[b_axis] + sb;
        diag[c_axis] = diag[c_axis] + sc;

        bool ob = get_voxel(edge_b) != 0u;
        bool oc = get_voxel(edge_c) != 0u;
        bool od = get_voxel(diag) != 0u;

        uint occluded = 0u;
        if (ob) {
            occluded = occluded + 1u;
        }
        if (oc) {
            occluded = occluded + 1u;
        }
        if (od) {
            occluded = occluded + 1u;
        }

        // Two edges meeting at a corner bury it completely, whatever the
        // diagonal does.
        if (ob && oc) {
            ao[i] = 0u;
        } else {
            ao[i] = 3u - occluded;
        }
    }
    return ao;
}

void main() {
    Face info = find_face();
    if (!info.valid) {
        return;
    }
    uint idx = atomicAdd(face_count, 1);
    atomicAdd(vertex_count, 6);
    uvec4 occlusion = surface_occlusion(info.voxel, info.axis, info.inward);
    surfaces[idx] = surface(info.voxel, info.axis, info.inward, info.material, occlusion);
}
