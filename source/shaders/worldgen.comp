#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform Params {
    int dimension;
};

layout(set = 0, binding = 1, std140) uniform WorldgenParams {
    mat4 chunkToNode;
    vec4 surfaceNormal;
    vec4 roadPlaneNormal;
    vec4 scalars;     // x=surfExponent, y=roadExponent, z=uintBitsToFloat(flags)
    uvec2 rngSeed;    // initial splitmix64 state as (lo, hi)
    vec2 _pad;
    vec4 elev0;
    vec4 elev1;
    vec4 temp0;
    vec4 temp1;
    vec4 rain0;
    vec4 rain1;
    vec4 block0;
    vec4 block1;
};

struct VoronoiEntry {
    float rain;
    float temp;
    uint material;
    uint _pad;
};

layout(set = 0, binding = 2, std430) readonly buffer VoronoiTable {
    VoronoiEntry voronoi_data[];
};

layout(set = 1, binding = 0, std430) buffer Voxels {
    uint voxel_pair[];
};

const float TERRAIN_SMOOTHNESS = 10.0;
const float TERRAIN_SURFACE_THICKNESS = 0.2;
const float PI = 3.14159265358979;

// ---- Emulated uint64 arithmetic using uvec2 (lo, hi) ----

uvec2 u64_add(uvec2 a, uvec2 b) {
    uint lo = a.x + b.x;
    uint hi = a.y + b.y + uint(lo < a.x);
    return uvec2(lo, hi);
}

uvec2 u64_mul(uvec2 a, uvec2 b) {
    // Full 64-bit multiply: (a.y:a.x) * (b.y:b.x), keep low 64 bits
    // Split into 16-bit pieces for a.x * b.x to get carry
    uint a0 = a.x & 0xFFFFu;
    uint a1 = a.x >> 16;
    uint b0 = b.x & 0xFFFFu;
    uint b1 = b.x >> 16;

    uint p00 = a0 * b0;
    uint p01 = a0 * b1;
    uint p10 = a1 * b0;
    uint p11 = a1 * b1;

    uint mid = p01 + (p00 >> 16);
    mid += p10;
    uint carry = uint(mid < p10);

    uint lo = (p00 & 0xFFFFu) | (mid << 16);
    uint hi = p11 + (mid >> 16) + (carry << 16) + a.x * b.y + a.y * b.x;
    return uvec2(lo, hi);
}

uvec2 u64_xor(uvec2 a, uvec2 b) {
    return uvec2(a.x ^ b.x, a.y ^ b.y);
}

uvec2 u64_shr(uvec2 v, uint n) {
    if (n >= 32u) {
        return uvec2(v.y >> (n - 32u), 0u);
    }
    if (n == 0u) {
        return v;
    }
    return uvec2((v.x >> n) | (v.y << (32u - n)), v.y >> n);
}

// Splitmix64: advance state, return full 64-bit result as uvec2
uvec2 splitmix64_full(inout uvec2 state) {
    const uvec2 INCREMENT = uvec2(0x7F4A7C15u, 0x9E3779B9u);
    state = u64_add(state, INCREMENT);
    uvec2 z = state;
    z = u64_mul(u64_xor(z, u64_shr(z, 30u)), uvec2(0x1CE4E5B9u, 0xBF58476Du));
    z = u64_mul(u64_xor(z, u64_shr(z, 27u)), uvec2(0x133111EBu, 0x94D049BBu));
    z = u64_xor(z, u64_shr(z, 31u));
    return z;
}

// Match CPU's rngNormal: Box-Muller using bits 40-63 of two splitmix64 outputs
float rngNorm(inout uvec2 state, float stddev) {
    uvec2 v1 = splitmix64_full(state);
    uvec2 v2 = splitmix64_full(state);
    // CPU: u1 = ((v1 >> 40) + 1) / ((1 << 24) + 2)
    // v1 >> 40 = top 24 bits = v1.y >> 8
    float u1 = float((v1.y >> 8) + 1u) / float((1u << 24) + 2u);
    // CPU: u2 = (v2 >> 40) / (1 << 24)
    float u2 = float(v2.y >> 8) / float(1u << 24);
    return sqrt(-2.0 * log(u1)) * cos(2.0 * PI * u2) * stddev;
}

// ---- Hyperbolic geometry ----

float mip(vec4 a, vec4 b) {
    return dot(a.xyz, b.xyz) - a.w * b.w;
}

vec4 normalizeHyperboloid(vec4 v) {
    float s2 = -mip(v, v);
    return s2 > 0.0 ? v / sqrt(s2) : vec4(0, 0, 0, 1);
}

float planeDist(vec4 normal, float exponent, vec4 point) {
    float m = mip(normal, point);
    if (exponent == 0.0) {
        return asinh(m);
    }
    float m2 = m * 2.0;
    return (log(abs(m2)) + exponent) * sign(m2);
}

float planeDistChunk(vec4 normal, float exponent, vec3 coord) {
    vec4 v = chunkToNode * vec4(coord, 1.0);
    return planeDist(normal, exponent, normalizeHyperboloid(v));
}

// ---- Terrain math ----

float trilerp8(vec4 lo, vec4 hi, vec3 t) {
    float l00 = mix(lo.x, hi.x, t.x);
    float l01 = mix(lo.y, hi.y, t.x);
    float l10 = mix(lo.z, hi.z, t.x);
    float l11 = mix(lo.w, hi.w, t.x);
    return mix(mix(l00, l10, t.y), mix(l01, l11, t.y), t.z);
}

float serp(float v0, float v1, float t, float th) {
    if (t < th) return v0;
    if (t >= 1.0 - th) return v1;
    return mix(v0, v1, (t - th) / (1.0 - 2.0 * th));
}

float terracingDiff(float e, float b, float sc, float st, float lim) {
    float th = st / (1.0 + exp2(lim - b));
    float ef = floor(e / sc);
    float er = e / sc - ef;
    return sc * ef + serp(0.0, sc, er, th) - e;
}

uint voronoiLookup(float elev, float rain, float temp, float dist) {
    int stratum;
    if (dist <= TERRAIN_SURFACE_THICKNESS) {
        stratum = elev < -30.0 ? 4 : elev < -12.0 ? 5 : elev < 2.0 ? 6 : 7;
    } else {
        stratum = elev < -30.0 ? 3 : elev < -12.0 ? 2 : elev < 2.0 ? 1 : 0;
    }
    int base = stratum * 113;
    float best = 1e30;
    uint mat = 0u;
    for (int i = 0; i < 113; i++) {
        VoronoiEntry e = voronoi_data[base + i];
        float d = (e.rain - rain) * (e.rain - rain) + (e.temp - temp) * (e.temp - temp);
        if (d < best) {
            best = d;
            mat = e.material;
        }
    }
    return mat;
}

void writeVoxel(int x, int y, int z, uint mat) {
    int lwm = dimension + 2;
    int idx = (x + 1) + (y + 1) * lwm + (z + 1) * lwm * lwm;
    uint pi = uint(idx) / 2u;
    uint shift = (uint(idx) & 1u) * 16u;
    if (mat != 0u) {
        atomicOr(voxel_pair[pi], (mat & 0xFFFFu) << shift);
    }
}

void main() {
    int dim = dimension;
    ivec3 v = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(v, ivec3(dim)))) return;

    int x = v.x, y = v.y, z = v.z;
    vec3 center = (vec3(v) + 0.5) / float(dim);
    vec3 tc = (1.0 - center) * 0.5;

    float surfExp = scalars.x;
    float roadExp = scalars.y;
    uint flags = floatBitsToUint(scalars.z);

    // Compute RNG state for this voxel matching CPU's sequential order:
    // CPU iterates x outer, y middle, z inner, consuming 6 values per voxel.
    uint linearIdx = uint(x * dim * dim + y * dim + z);
    const uvec2 INCREMENT = uvec2(0x7F4A7C15u, 0x9E3779B9u);
    // Advance seed by linearIdx * 6 increments
    uvec2 advance = u64_mul(uvec2(linearIdx * 6u, 0u), INCREMENT);
    uvec2 rng = u64_add(rngSeed, advance);

    float rain = trilerp8(rain0, rain1, tc) + rngNorm(rng, 0.03);
    float temp = trilerp8(temp0, temp1, tc) + rngNorm(rng, 0.03);
    float ePre = trilerp8(elev0, elev1, tc);
    float blk  = trilerp8(block0, block1, tc);
    float vElev = planeDistChunk(surfaceNormal, surfExp, center);
    float str = 0.4 / (1.0 + vElev * vElev);
    float tS = terracingDiff(ePre, blk, 5.0, str, 2.0);
    float tB = terracingDiff(ePre, blk, 15.0, str, -1.0);
    float ePN = ePre + 0.6 * tS + 0.4 * tB;
    float dPN = ePN / TERRAIN_SMOOTHNESS - vElev;
    float elev = ePN + TERRAIN_SMOOTHNESS * rngNorm(rng, 0.03);

    float dist;
    if (dPN > 0.0) {
        dist = max(elev / TERRAIN_SMOOTHNESS - vElev, 0.0);
    } else {
        dist = dPN;
    }

    uint mat = 0u;
    if (dist >= 0.0) {
        mat = voronoiLookup(elev, rain, temp, dist);
    }

    bool isRoad = (flags & 1u) != 0u;
    bool isSupport = (flags & 2u) != 0u;

    if (isRoad) {
        float hD = planeDistChunk(roadPlaneNormal, roadExp, center);
        if (hD <= 0.3 && vElev <= 0.9) {
            mat = vElev < 0.075 ? (hD < 0.15 ? 29u : 28u) : 0u;
        }
    } else if (isSupport) {
        float hD = planeDistChunk(roadPlaneNormal, roadExp, center);
        if (hD <= 0.3) {
            int off = dim / 3;
            int cm = int(x==off) + int(y==off) + int(z==off) + int(x==y) + int(y==z) + int(x==z);
            if (cm >= 2) mat = 27u;
        }
    }

    writeVoxel(x, y, z, mat);

    if (x == 0) writeVoxel(-1, y, z, mat);
    if (x == dim-1) writeVoxel(dim, y, z, mat);
    if (y == 0) writeVoxel(x, -1, z, mat);
    if (y == dim-1) writeVoxel(x, dim, z, mat);
    if (z == 0) writeVoxel(x, y, -1, mat);
    if (z == dim-1) writeVoxel(x, y, dim, mat);
}
