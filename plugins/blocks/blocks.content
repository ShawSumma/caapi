blocks-materials blocks:materials {
    road -> base:basalt
    sidewalk -> base:concrete
    marking -> base:white-brick
    leaves -> base:oak-leaves
    trunk -> base:oak-wood
    basin -> base:marble
    water -> base:water
    pond-bed -> base:sand
    lot -> base:concrete
    plaza -> base:granite
    park -> base:grass
    kerb -> base:concrete
    frame -> base:steel
    tunnel -> base:wet-concrete
    tunnel-light -> base:light-panel
    bore-light -> base:sunlight
    ballast -> base:gravel
    rail -> base:steel
    platform -> base:concrete
    platform-edge -> base:pollen
    station-wall -> base:white-brick
    station-ceiling -> base:plaster
    pillar -> base:steel
    mezzanine -> base:ceiling-tile
    railing -> base:steel
    entrance -> base:steel
    transfer -> base:acacia-wood
    stop -> base:lava
    go -> base:sunlight
    car -> base:steel
    window -> base:glass
    bench -> base:wood-planks
    tablet -> base:slate
    letter -> base:white-brick
    rubble -> base:gravel
    graffiti -> [base:red-sandstone base:clay base:slate base:dolomite]
    palettes -> [blocks:local blocks:express blocks:uptown blocks:terminal blocks:crosstown]
    abandoned -> blocks:abandoned
}

subway-palette blocks:local { wall -> base:white-brick, band -> base:red-sandstone, trim -> base:steel }
subway-palette blocks:express { wall -> base:white-brick, band -> base:slate, trim -> base:steel }
subway-palette blocks:uptown { wall -> base:white-brick, band -> base:clay, trim -> base:basalt }
subway-palette blocks:terminal { wall -> base:marble, band -> base:dolomite, trim -> base:sandstone }
subway-palette blocks:crosstown { wall -> base:limestone, band -> base:grey-brick, trim -> base:steel }
subway-palette blocks:abandoned { wall -> base:wet-concrete, band -> base:grey-brick, trim -> base:basalt }

connector-ground blocks:ground {
    tag: "horospheres:city"
    level: 1
}

connector-materials connector:materials {
    grounds -> blocks:ground
}

blocks-zoning blocks:zoning {
    districts -> [blocks:midtown blocks:downtown blocks:rows blocks:works blocks:green]
    route -> buildings:tenement
}

blocks-district blocks:midtown {
    rules -> [blocks:corner blocks:slab blocks:wide blocks:around]
    island -> blocks:island
}

blocks-district blocks:downtown {
    street-trees: 0.15
    park-percent: 2
    plaza-percent: 10
    parking-percent: 1
    rules -> [blocks:tower-corner blocks:tower-slab blocks:tower-wide blocks:tower-around]
    island -> blocks:tower-island
}

blocks-district blocks:rows {
    street-trees: 0.9
    park-percent: 9
    plaza-percent: 3
    parking-percent: 0
    rules -> [blocks:row-corner blocks:row-slab blocks:row-wide blocks:row-around]
    island -> blocks:row-island
}

blocks-district blocks:works {
    street-trees: 0.05
    ports: 0.15
    park-percent: 1
    plaza-percent: 2
    parking-percent: 14
    rules -> [blocks:works-corner blocks:works-slab blocks:works-wide blocks:works-around]
    island -> blocks:works-island
}

blocks-district blocks:green {
    street-trees: 0.8
    park-percent: 30
    plaza-percent: 14
    parking-percent: 0
    rules -> [blocks:green-corner blocks:green-slab blocks:green-wide blocks:green-around]
    island -> blocks:green-island
}

