blocks-materials blocks:materials {
    road -> base:basalt
    sidewalk -> base:concrete
    marking -> base:white-brick
    leaves -> base:oak-leaves
    trunk -> base:oak-wood
    basin -> base:marble
    water -> base:water
    pond-bed -> base:sand
    lot -> base:concrete
    plaza -> base:granite
    park -> base:grass
}

connector-ground blocks:ground {
    tag: "horospheres:city"
    level: 1
}

connector-materials connector:materials {
    grounds -> blocks:ground
}

blocks-zoning blocks:zoning {
    districts -> [blocks:midtown blocks:downtown blocks:rows blocks:works blocks:green]
    route -> buildings:tenement
}

blocks-district blocks:midtown {
    rules -> [blocks:corner blocks:slab blocks:wide blocks:around]
    island -> blocks:island
}

blocks-district blocks:downtown {
    street-trees: 0.15
    park-percent: 2
    plaza-percent: 10
    parking-percent: 1
    rules -> [blocks:tower-corner blocks:tower-slab blocks:tower-wide blocks:tower-around]
    island -> blocks:tower-island
}

blocks-district blocks:rows {
    street-trees: 0.9
    park-percent: 9
    plaza-percent: 3
    parking-percent: 0
    rules -> [blocks:row-corner blocks:row-slab blocks:row-wide blocks:row-around]
    island -> blocks:row-island
}

blocks-district blocks:works {
    street-trees: 0.05
    park-percent: 1
    plaza-percent: 2
    parking-percent: 14
    rules -> [blocks:works-corner blocks:works-slab blocks:works-wide blocks:works-around]
    island -> blocks:works-island
}

blocks-district blocks:green {
    street-trees: 0.8
    park-percent: 30
    plaza-percent: 14
    parking-percent: 0
    rules -> [blocks:green-corner blocks:green-slab blocks:green-wide blocks:green-around]
    island -> blocks:green-island
}

