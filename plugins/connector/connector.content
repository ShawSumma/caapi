connector-materials connector:materials {
    landing -> base:concrete
    window -> base:glass
    stone -> base:marble
    light -> base:sunlight
    palettes -> [connector:brick connector:sandstone connector:steel connector:grey]
    drift -> connector:drift
    lantern -> connector:lantern
    hidden -> connector:hidden
    pairs -> [connector:wild-wild connector:wild-city connector:wild-backrooms connector:wild-library connector:city-wild connector:city-city connector:city-backrooms connector:city-library connector:backrooms-wild connector:backrooms-city connector:backrooms-backrooms connector:backrooms-library connector:library-wild connector:library-city connector:library-backrooms connector:library-library]
}

