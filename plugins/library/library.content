connector-ground library:ground {
    tag: "library:library"
    level: 1
    dress: shelves
}

connector-materials connector:materials {
    grounds -> library:ground
}

look library:look { red: 0.72, green: 0.62, blue: 0.46, tint: fog }

library-materials library:materials {
    frame -> base:spruce-wood
    ceiling -> base:plaster
    lamp -> base:light-panel
    table -> base:oak-wood
    stair -> base:marble
    well -> base:glass
    partition -> base:plaster
    lounge -> base:carpet
    press -> pharmacology:press
    lab -> pharmacology:lab
    bench -> pharmacology:bench
    locker -> base:steel
    sink -> base:water
    workbench -> game:workbench
    staff-floor -> base:concrete
    staff-ceiling -> base:ceiling-tile
    staff-wall -> base:wallpaper
    catalog -> pharmacology:catalog
    pipe -> base:steel
    floors -> [base:wood-planks base:spruce-wood base:marble base:red-carpet]
    books -> [base:red-carpet base:acacia-wood base:jungle-wood base:birch-wood base:oak-wood base:carpet base:red-sandstone]
    rooms -> [library:reading-room library:childrens-corner library:meeting-room library:carrels library:office library:narrow-stacks library:stairs-down library:storage library:boiler-room library:archive library:deep-stacks library:stairs-deeper]
}

library-room library:reading-room {
    weight: 3
    level: main
    wall -> base:plaster
    floor -> base:carpet
    light -> base:light-panel
    pieces -> [library:wall-shelf library:wall-books library:reading-table library:armchair-west library:armchair-east library:pamphlet]
}

library-room library:childrens-corner {
    weight: 2
    level: main
    wall -> base:plaster
    floor -> base:red-carpet
    light -> base:light-panel
    pieces -> [library:low-books-along library:low-books-across library:rug library:small-table library:other-small-table]
}

library-room library:meeting-room {
    weight: 2
    level: main
    wall -> base:glass
    floor -> base:carpet
    light -> base:light-panel
    pieces -> [library:long-table library:near-bench library:far-bench library:pamphlet]
}

library-room library:carrels {
    weight: 2
    level: main
    wall -> base:plaster
    floor -> base:wood-planks
    light -> base:light-panel
    pieces -> [library:desks-along library:desks-across library:divider library:other-divider]
}

library-room library:office {
    weight: 1
    level: main
    wall -> base:plaster
    floor -> base:carpet
    light -> base:light-panel
    pieces -> [library:lockers library:office-desk library:office-chair library:filing library:pamphlet]
}

library-room library:narrow-stacks {
    weight: 2
    level: main
    wall -> base:plaster
    light -> base:light-panel
    pieces -> [library:stack-row-1 library:stack-books-1 library:stack-row-2 library:stack-books-2 library:stack-row-3 library:stack-books-3]
}

library-room library:stairs-down {
    weight: 1
    level: main
    wall -> base:plaster
    floor -> base:marble
    light -> base:light-panel
    stair: down
    pieces -> [library:stair-shelf library:stair-books library:stair-rail]
}

library-room library:storage {
    weight: 3
    level: basement
    wall -> base:grey-brick
    floor -> base:concrete
    light -> base:light-panel
    pieces -> [library:crates library:crate library:crate-stack library:loose-crate]
}

library-room library:boiler-room {
    weight: 1
    level: basement
    wall -> base:grey-brick
    floor -> base:concrete
    light -> base:light-panel
    pieces -> [library:boiler library:firebox library:firebox-glass library:boiler-pipe]
}

library-room library:archive {
    weight: 2
    level: basement
    wall -> base:concrete
    floor -> base:slate
    light -> base:light-panel
    pieces -> [library:archive-row-1 library:archive-books-1 library:archive-row-2 library:archive-books-2 library:archive-row-3 library:archive-books-3]
}

library-room library:deep-stacks {
    weight: 3
    level: basement
    wall -> base:plaster
    light -> base:light-panel
    pieces -> [library:stack-row-1 library:stack-books-1 library:stack-row-2 library:stack-books-2 library:stack-row-3 library:stack-books-3]
}

library-room library:stairs-deeper {
    weight: 1
    level: basement
    wall -> base:grey-brick
    floor -> base:concrete
    light -> base:light-panel
    stair: down
    pieces -> [library:stair-shelf library:stair-books library:stair-rail]
}

library-piece library:wall-shelf { material -> base:spruce-wood, x: 1, y: 1, wide: 7, tall: 3 }
library-piece library:wall-books { x: 1, y: 1, wide: 7, z: 2 }
library-piece library:reading-table { material -> base:oak-wood, x: 3, y: 4, wide: 3 }
library-piece library:pamphlet { material -> game:pamphlet, x: 4, y: 4, z: 2 }
library-piece library:armchair-west { material -> base:red-carpet, x: 2, y: 4 }
library-piece library:armchair-east { material -> base:red-carpet, x: 6, y: 4 }
library-piece library:low-books-along { x: 1, y: 1, wide: 7 }
library-piece library:low-books-across { x: 1, y: 2, deep: 4 }
library-piece library:rug { material -> base:carpet, x: 3, y: 4, wide: 3, deep: 2, z: 0 }
library-piece library:small-table { material -> base:birch-wood, x: 3, y: 4 }
library-piece library:other-small-table { material -> base:birch-wood, x: 5, y: 5 }
library-piece library:long-table { material -> base:white-brick, x: 2, y: 3, wide: 5, deep: 3 }
library-piece library:near-bench { material -> base:spruce-wood, x: 3, y: 2, wide: 3 }
library-piece library:far-bench { material -> base:spruce-wood, x: 3, y: 6, wide: 3 }
library-piece library:desks-along { material -> base:oak-wood, x: 1, y: 2, deep: 6 }
library-piece library:desks-across { material -> base:oak-wood, x: 2, y: 1, wide: 6 }
library-piece library:divider { material -> base:spruce-wood, x: 1, y: 4, wide: 2, tall: 2 }
library-piece library:other-divider { material -> base:spruce-wood, x: 4, y: 1, deep: 2, tall: 2 }
library-piece library:lockers { material -> base:steel, x: 1, y: 1, wide: 3, tall: 2 }
library-piece library:office-desk { material -> base:oak-wood, x: 3, y: 4, wide: 3 }
library-piece library:office-chair { material -> base:spruce-wood, x: 4, y: 5 }
library-piece library:filing { material -> base:steel, x: 1, y: 5, deep: 2, tall: 2 }
library-piece library:stack-row-1 { material -> base:spruce-wood, x: 1, y: 2, wide: 6, tall: 3 }
library-piece library:stack-books-1 { x: 1, y: 2, wide: 6, z: 2 }
library-piece library:stack-row-2 { material -> base:spruce-wood, x: 1, y: 4, wide: 6, tall: 3 }
library-piece library:stack-books-2 { x: 1, y: 4, wide: 6, z: 2 }
library-piece library:stack-row-3 { material -> base:spruce-wood, x: 1, y: 6, wide: 6, tall: 3 }
library-piece library:stack-books-3 { x: 1, y: 6, wide: 6, z: 2 }
library-piece library:stair-shelf { material -> base:spruce-wood, x: 1, y: 7, wide: 3, tall: 3 }
library-piece library:stair-books { x: 1, y: 7, wide: 3, z: 2 }
library-piece library:stair-rail { material -> base:limestone, x: 2, y: 4, wide: 4 }
library-piece library:crates { material -> base:oak-wood, x: 1, y: 1, wide: 2, deep: 2, tall: 2 }
library-piece library:crate { material -> base:spruce-wood, x: 5, y: 1, wide: 2 }
library-piece library:crate-stack { material -> base:oak-wood, x: 1, y: 5, deep: 2, tall: 3 }
library-piece library:loose-crate { material -> base:spruce-wood, x: 3, y: 6 }
library-piece library:boiler { material -> base:steel, x: 2, y: 2, wide: 3, deep: 3, tall: 4 }
library-piece library:firebox { material -> base:lava, x: 3, y: 5 }
library-piece library:firebox-glass { material -> base:glass, x: 3, y: 6 }
library-piece library:boiler-pipe { material -> base:steel, x: 5, y: 3, wide: 3, z: 4 }
library-piece library:archive-row-1 { material -> base:steel, x: 1, y: 2, wide: 6, tall: 3 }
library-piece library:archive-books-1 { x: 1, y: 2, wide: 6, z: 2, tall: 2 }
library-piece library:archive-row-2 { material -> base:steel, x: 1, y: 4, wide: 6, tall: 3 }
library-piece library:archive-books-2 { x: 1, y: 4, wide: 6, z: 2, tall: 2 }
library-piece library:archive-row-3 { material -> base:steel, x: 1, y: 6, wide: 6, tall: 3 }
library-piece library:archive-books-3 { x: 1, y: 6, wide: 6, z: 2, tall: 2 }
