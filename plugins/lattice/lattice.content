look lattice:look { red: 0.05, green: 0.06, blue: 0.1, tint: fog }

lattice-materials lattice:materials {
    pole -> base:steel
    girder -> base:concrete
    joint -> base:basalt
    step -> base:wood-planks
    lantern -> base:light-panel
    leaves -> base:oak-leaves
    hut -> base:wood-planks
    roof -> base:red-sandstone
    floors -> [base:wood-planks base:marble base:grey-brick]
    island -> base:andesite
    turf -> base:grass
    soil -> base:dirt
    bridge -> base:wood-planks
    colossus -> base:gabbro
    limb -> base:marble
    weaves -> [lattice:plain lattice:sparse lattice:heavy lattice:ruined lattice:doubled lattice:regular]
    star -> base:light-panel
    deck -> base:wood-planks
    rafter -> base:spruce-wood
    shelf -> base:spruce-wood
    shelf-decks -> [base:wood-planks base:marble base:red-carpet]
    books -> [base:red-carpet base:acacia-wood base:jungle-wood base:birch-wood base:oak-wood base:carpet base:red-sandstone]
    rocks -> [base:andesite base:basalt base:gabbro base:granite base:slate base:diorite]
    corners -> [lattice:bare-joint lattice:marble-hub lattice:lamp-hub lattice:basalt-flare lattice:steel-cage]
}

lattice-corner lattice:bare-joint { form: joint, material -> base:basalt }
lattice-corner lattice:marble-hub { form: hub, material -> base:marble, half: 3 }
lattice-corner lattice:lamp-hub { form: hub, material -> base:light-panel, half: 1 }
lattice-corner lattice:basalt-flare { form: flare, material -> base:basalt, half: 4 }
lattice-corner lattice:steel-cage { form: cage, material -> base:steel, half: 5 }

lattice-weave lattice:plain { }
lattice-weave lattice:sparse { keep: 0.55, platform-odds: 0.2, stair-odds: 0.3 }
lattice-weave lattice:heavy { beam: 2, platform-odds: 0.06, stair-odds: 0.1 }
lattice-weave lattice:ruined { broken: 0.4, keep: 0.8, platform-odds: 0.05 }
lattice-weave lattice:doubled { doubled: 0.7, platform-odds: 0.08 }
lattice-weave lattice:regular { regular: regular, platform-odds: 0, stair-odds: 0 }
