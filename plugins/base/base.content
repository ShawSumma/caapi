}

upgrade base:assay-kit {
    title: "assay kit"
    effect: "assay"
}

insight base:charring {
    title: "charring"
    notice: "Wood left in the furnace's heat turns to charcoal, and charcoal worked through ore gives back more metal."
    noticed-working -> base:furnace-station
}

insight base:sifting {
    title: "sifting"
    notice: "Loam, grass and dirt are sand and clay held together; sifted, they come apart, and the finest of them melts to glass."
    noticed-breaking -> base:siftable
}

insight base:quenching {
    title: "quenching"
    notice: "Water poured over hot sand sets more glass, lava cools to glass, and melted ice carries a polar graft."
    noticed-breaking -> base:waters
}

insight base:salvage {
    title: "salvage"
    notice: "What others built can be taken apart: masonry crushes to grit, cloth chars or pulps, lamps keep their glass and steel gives back its iron."
    noticed-breaking -> base:built-materials
}

insight base:strangeness {
    title: "strangeness"
    notice: "Blocks that only appear to an altered eye still carry charge and bulk."
    noticed-breaking -> base:strange-stones
}

recipe base:planks {
    seconds: 0.5
    at -> engine:hand
    produces -> base:wood-planks { yield: 4 }
    consumes -> base:woods
}

recipe base:make-workbench {
    seconds: 1.5
    at -> engine:hand
    produces -> base:workbench
    consumes -> base:wood-planks { count: 6 }
}

recipe base:make-wooden-pickaxe {
    seconds: 1.5
    at -> base:workbench-station
    produces -> base:wooden-pickaxe
    consumes -> base:wood-planks { count: 3 }
}

recipe base:make-stone-pickaxe {
    seconds: 2
    at -> base:workbench-station
    produces -> base:stone-pickaxe
    consumes -> base:wood-planks { count: 2 }
    consumes -> base:stones { count: 3 }
}

recipe base:make-furnace {
