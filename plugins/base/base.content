tree base:oak {
    shape: "round"
    trunk: 4
    trunk-choices: 2
    reach: 2
    wood -> base:oak-wood
    leaves -> base:oak-leaves
    grows-on -> base:plant-ground
}

tree base:birch {
    shape: "round"
    trunk: 5
    trunk-choices: 2
    reach: 2
    wood -> base:birch-wood
    leaves -> base:birch-leaves
    grows-on -> base:plant-ground
}

tree base:spruce {
    shape: "cone"
    trunk: 5
    trunk-choices: 3
    reach: 2
    wood -> base:spruce-wood
    leaves -> base:spruce-leaves
    grows-on -> base:plant-ground
}

tree base:big-oak {
    shape: "broad"
    trunk: 5
    trunk-choices: 2
    reach: 3
    wood -> base:oak-wood
    leaves -> base:oak-leaves
    grows-on -> base:plant-ground
}

tree base:cherry {
    shape: "round"
    trunk: 4
    trunk-choices: 2
    reach: 2
    wood -> base:spruce-wood
    leaves -> base:cherry-leaves
    grows-on -> base:plant-ground
}

tree base:maple {
    shape: "round"
    trunk: 4
    trunk-choices: 3
