}

perception-preset base:heavy {
    sets -> engine:walk-speed { level: -0.4 }
    sets -> engine:gravity { level: 0.7 }
    sets -> engine:jump-height { level: -0.7 }
}

perception-preset base:light {
    sets -> engine:gravity { level: -0.9 }
    sets -> engine:jump-height { level: 0.9 }
}

perception-preset base:wide {
    sets -> engine:field-of-view { level: 0.9 }
}

perception-preset base:narrow {
    sets -> engine:field-of-view { level: -0.6 }
    sets -> engine:fog { level: 1.2 }
}

perception-preset base:behind {
    sets -> engine:eye-offset { level: 0.4 }
}

perception-preset base:swaying {
    sets -> engine:warp { level: 0.1 }
}

perception-preset base:turned {
    sets -> engine:color-turn-0 { level: 1.2 }
    sets -> engine:color-turn-3 { level: 0.8 }
}

perception-preset base:mist-sight {
    sets -> engine:reveal-mist { level: 1 }
}

perception-preset base:afterimage {
    sets -> engine:afterimage { level: 1 }
}

perception-preset base:sharp {
    sets -> engine:fine-detail { level: 0.9 }
}

perception-preset base:soft {
    sets -> engine:fine-detail { level: -2.5 }
    sets -> engine:coarse-detail { level: -1 }
}

starter-body base:starter {
    halves -> [base:receptor-a base:receptor-b base:receptor-c]
    enzymes -> [base:oxidase base:conjugase]
    doses -> [base:swallowed-dose base:inhaled-dose base:injected-dose]
}

receptor-half base:receptor-a {
    cells: "wall open-polar wall trigger-0 open-bulky trigger-0 wall open-charged wall open-polar wall trigger-0 wall"
}

receptor-half base:receptor-b {
    cells: "wall open-charged wall trigger-1 open-polar+bulky trigger-1 wall open-bulky wall wall open-charged wall trigger-1"
}

receptor-half base:receptor-c {
    cells: "wall open-bulky+charged wall brake open-polar wall wall open-bulky wall open-charged wall wall brake"
    expression: 0.5
}

enzyme base:oxidase { operation: oxidize, wants: "bulky+charged" }
enzyme base:conjugase { operation: conjugate, wants: "polar+charged" }

chemistry base:mist-opening { targets -> base:receptor-a, skips: brake }
chemistry base:mist-closing { targets -> base:receptor-a, skips: trigger }
chemistry base:swayer { targets -> base:receptor-b, skips: brake }
chemistry base:lifting { targets -> [base:receptor-a base:receptor-b], skips: brake }
chemistry base:dulling { targets -> base:receptor-c, skips: trigger }

starter-dose base:swallowed-dose { half -> base:receptor-a, skips: brake, route: ingested, amount: 2 }
starter-dose base:inhaled-dose { half -> base:receptor-b, skips: brake, route: inhaled, amount: 2 }
starter-dose base:injected-dose { half -> base:receptor-c, skips: trigger, route: injected, amount: 2 }

signal-drive base:mist-reveals { signal: mist, gain: 2, drives -> engine:reveal-mist }
signal-drive base:mist-turns { signal: mist, gain: 1.2, drives -> engine:color-turn-0 }
signal-drive base:sway-warps { signal: sway, gain: 0.15, drives -> engine:warp }
signal-drive base:sway-widens { signal: sway, gain: 0.6, drives -> engine:field-of-view }
signal-drive base:sway-lingers { signal: sway, gain: 1, drives -> engine:afterimage }
signal-drive base:lift-lightens { signal: lift, gain: -0.8, drives -> engine:gravity }
signal-drive base:lift-raises { signal: lift, gain: 0.8, drives -> engine:jump-height }

terrain base:terrain {
    flat-fill -> base:dirt
    stand-in -> base:dirt
}

