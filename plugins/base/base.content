    wood -> base:oak-wood
    leaves -> base:maple-leaves
    grows-on -> base:plant-ground
}

tree base:willow {
    shape: "weeping"
    trunk: 5
    trunk-choices: 2
    reach: 2
    wood -> base:oak-wood
    leaves -> base:willow-leaves
    grows-on -> [base:plant-ground base:mud]
}

tree base:jungle {
    shape: "tall"
    trunk: 7
    trunk-choices: 3
    reach: 2
    wood -> base:jungle-wood
    leaves -> base:jungle-leaves
    grows-on -> base:plant-ground
}

tree base:acacia {
    shape: "flat"
    trunk: 3
    trunk-choices: 2
    reach: 3
    wood -> base:acacia-wood
    leaves -> base:acacia-leaves
    grows-on -> base:plant-ground
}

tree base:shrub {
    shape: "bush"
    wood -> base:oak-wood
    leaves -> base:oak-leaves
    grows-on -> [base:plant-ground base:mud]
}

tree base:snag {
    shape: "bare"
    trunk: 3
    trunk-choices: 3
    wood -> base:spruce-wood
    grows-on -> [base:plant-ground base:snow base:gravel]
}

tree base:cactus-tree {
    shape: "column"
    trunk: 2
    trunk-choices: 3
    wood -> base:cactus
    grows-on -> [base:sand base:red-sand]
}

tree base:giant-mushroom {
    shape: "cap"
    trunk: 4
    trunk-choices: 3
    reach: 3
    wood -> base:mushroom-stem
    leaves -> base:mushroom-cap
    grows-on -> [base:plant-ground base:mud]
}

tree base:giant-flower {
    shape: "bloom"
    trunk: 5
    trunk-choices: 3
    reach: 2
    wood -> base:flower-stem
    leaves -> base:petals
    heart -> base:pollen
    grows-on -> base:plant-ground
}

tree-rule base:desert-trees {
    warmth-above: 0.45
    wetness-below: -0.35
    picks -> base:cactus-tree
}

tree-rule base:frozen-snags {
    order: 10
    warmth-below: -0.45
    one-in: 3
    draw: "choice"
    picks -> base:snag
}

tree-rule base:frozen-trees {
    order: 20
    warmth-below: -0.45
    picks -> base:spruce
}

tree-rule base:cold-birches {
    order: 30
    warmth-below: -0.2
    one-in: 6
    draw: "choice"
    picks -> base:birch
}

tree-rule base:cold-trees {
    order: 40
    warmth-below: -0.2
    picks -> base:spruce
}

tree-rule base:shrubs {
    order: 50
    one-in: 8
    draw: "roll"
    picks -> base:shrub
}

tree-rule base:tropical-oaks {
    order: 60
    warmth-above: 0.25
    wetness-above: 0.45
    one-in: 3
    draw: "choice"
    picks -> base:big-oak
}

tree-rule base:tropical-trees {
    order: 70
    warmth-above: 0.25
    wetness-above: 0.45
    picks -> base:jungle
}

tree-rule base:savanna-trees {
    order: 80
    warmth-above: 0.25
    wetness-below: -0.05
    picks -> base:acacia
}

tree-rule base:wet-trees {
    order: 90
    wetness-above: 0.45
    picks -> [base:willow base:big-oak base:oak base:giant-mushroom]
}

tree-rule base:cool-trees {
    order: 100
    warmth-below: 0.05
    picks -> [base:maple base:maple base:birch base:oak base:giant-mushroom]
}

tree-rule base:mild-trees {
    order: 110
    picks -> [base:oak base:oak base:birch base:big-oak base:cherry base:maple base:giant-flower]
}

look base:sky {
}

perception-preset base:heavy {
    sets -> engine:walk-speed { level: -0.4 }
    sets -> engine:gravity { level: 0.7 }
    sets -> engine:jump-height { level: -0.7 }
}

perception-preset base:light {
    sets -> engine:gravity { level: -0.9 }
    sets -> engine:jump-height { level: 0.9 }
}

perception-preset base:wide {
    sets -> engine:field-of-view { level: 0.9 }
}

perception-preset base:narrow {
    sets -> engine:field-of-view { level: -0.6 }
    sets -> engine:fog { level: 1.2 }
}

perception-preset base:behind {
    sets -> engine:eye-offset { level: 0.4 }
}

perception-preset base:swaying {
    sets -> engine:warp { level: 0.1 }
}

perception-preset base:turned {
    sets -> engine:color-turn-0 { level: 1.2 }
    sets -> engine:color-turn-3 { level: 0.8 }
}

perception-preset base:mist-sight {
    sets -> base:mist { level: 1 }
}

perception-preset base:afterimage {
    sets -> engine:afterimage { level: 1 }
}

perception-preset base:sharp {
    sets -> engine:fine-detail { level: 0.9 }
}

perception-preset base:soft {
    sets -> engine:fine-detail { level: -2.5 }
    sets -> engine:coarse-detail { level: -1 }
}

terrain base:terrain {
    flat-fill -> base:dirt
    stand-in -> base:dirt
    broad-keep: 0.92
    broad-spread: 0.25
    local-keep: 0.5
    local-spread: 0.25
    heat-keep: 0.94
    heat-spread: 0.3
    wetness-keep: 0.94
    wetness-spread: 0.3
    strata-keep: 0.8
    strata-spread: 0.25
    ruggedness-keep: 0.9
    ruggedness-spread: 0.2
    shield-keep: 0.9
    shield-spread: 0.2
    rugged-threshold: 0.4
    mountain-height: 2.5
    lapse-rate: 0.3
    cover-depth: 0.06
    soil-depth: 0.4
    water-level: -0.6
    warmth-class-limit: 0.35
    rock-band-1: 1.2
    rock-band-2: 2.6
    rock-band-3: 4.5
    wetness-limit-1: -0.2
    wetness-limit-2: 0.3
    base-tree-density: 0.05
    wetness-per-tree-density: 4
    least-tree-density: 0.01
    most-tree-density: 0.3
    plant-density: 0.02
    vein-odds: 0.08
    vein-fill: 0.7
    vein-radius: 2
}

