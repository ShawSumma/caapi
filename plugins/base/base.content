group base:woods {
    label: "wood"
    member -> [base:oak-wood base:birch-wood base:spruce-wood base:jungle-wood base:acacia-wood base:mushroom-stem base:flower-stem]
}

group base:sands {
    label: "sand"
    member -> [base:sand base:red-sand base:sandstone base:red-sandstone]
}

group base:stones {
    label: "stone"
    member -> [base:limestone base:dolomite base:shale base:slate base:sandstone base:red-sandstone base:marble base:granite base:diorite base:andesite base:gabbro base:basalt base:olivine]
}

group base:leaves {
    label: "leaves"
    member -> [base:oak-leaves base:birch-leaves base:spruce-leaves base:jungle-leaves base:acacia-leaves base:cherry-leaves base:maple-leaves base:willow-leaves base:mushroom-cap base:petals]
}

group base:clays {
    label: "clay"
    member -> [base:clay base:clay-loam base:mud]
}

group base:sandy-soils {
    label: "sandy soil"
    member -> [base:sandy-loam base:gravel base:dirt base:grass base:lush-grass base:coarse-grass base:tan-grass base:mud-grass base:cave-grass]
}

group base:silty-soils {
    label: "silty soil"
    member -> [base:silt base:silty-loam base:clay-loam base:mud base:dirt base:grass base:lush-grass base:coarse-grass base:tan-grass base:mud-grass base:cave-grass]
}

group base:siftable {
    label: "soil"
    member -> [base:sandy-loam base:gravel base:dirt base:silt base:silty-loam base:clay-loam base:mud base:grass base:lush-grass base:coarse-grass base:tan-grass base:mud-grass base:cave-grass]
}

group base:fine-soils {
    label: "fine soil"
    member -> [base:silt base:silty-loam base:sandy-loam]
}

group base:waters {
    label: "water or ice"
    member -> [base:snow base:ice base:ice-slush base:water]
}

group base:rubble {
    label: "gravel or lava"
    member -> [base:gravel base:lava]
}

group base:masonry {
    label: "masonry"
    member -> [base:grey-brick base:white-brick base:concrete base:wet-concrete base:plaster base:ceiling-tile]
}

group base:cloth {
    label: "cloth"
    member -> [base:wallpaper base:stained-wallpaper base:carpet base:damp-carpet base:red-carpet]
}

group base:lamps {
    label: "lamp"
    member -> [base:light-panel base:sunlight]
}

group base:built-materials {
    label: "built material"
    member -> [base:grey-brick base:white-brick base:concrete base:wet-concrete base:plaster base:ceiling-tile base:wallpaper base:stained-wallpaper base:carpet base:damp-carpet base:red-carpet base:light-panel base:sunlight base:steel]
}

group base:strange-stones {
    label: "strange stone"
    member -> [base:mist-stone base:mist-light base:ember-stone base:ember-light base:tide-stone base:tide-light]
}

group base:plant-ground {
    label: "ground plants take to"
    member -> [base:dirt base:grass base:mud-grass base:lush-grass base:tan-grass base:coarse-grass]
}

upgrade base:wooden-pickaxe {
    title: "wooden pickaxe"
    effect: "mining"
    mining-tier: 1
}

upgrade base:stone-pickaxe {
    title: "stone pickaxe"
    effect: "mining"
    mining-tier: 2
}

upgrade base:copper-pickaxe {
    title: "copper pickaxe"
    effect: "mining"
    mining-tier: 3
}

upgrade base:iron-pickaxe {
    title: "iron pickaxe"
    effect: "mining"
