building-materials buildings:materials {
    window -> base:glass
    pad -> base:concrete
    marking -> base:white-brick
    tank-leg -> base:steel
    tank -> base:wood-planks
    lawn -> base:grass
    leaves -> base:oak-leaves
    trunk -> base:oak-wood
}

building-type buildings:brownstone {
    form: brownstone
    least-stories: 4
    most-stories: 5
    roof -> base:slate
    palettes -> [buildings:brownstone-1 buildings:brownstone-2 buildings:brownstone-3 buildings:brownstone-4 buildings:brownstone-5]
}
building-palette buildings:brownstone-1 { wall -> base:red-sandstone, trim -> base:sandstone, floor -> base:wood-planks }
