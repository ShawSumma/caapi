kind building-palette {
    wall: one -> material
    trim: one -> material
    floor: one -> material
    band: optional -> material
    roof: optional -> material
}

kind building-type {
    form: "brownstone" | "civic" | "deco" | "glass" | "modern" | "rowhouse" | "tenement" | "warehouse"
    least-stories: integer 1..
    most-stories: integer 1..
    roof: one -> material
    palettes: some -> building-palette
}

kind building-materials {
    window: one -> material
    pad: one -> material
    marking: one -> material
    tank-leg: one -> material
    tank: one -> material
    lawn: one -> material
    leaves: one -> material
    trunk: one -> material
}
