synthesis pharmacology:press-extract {
    title: "press for extract"
    operation: "extract"
    seconds: 2
    at -> pharmacology:press-station
}

synthesis pharmacology:press-dose {
    title: "press a dose"
    operation: "press"
    seconds: 2
    extract: 3
    at -> pharmacology:press-station
}

synthesis pharmacology:oxidize {
    title: "oxidize"
    operation: "oxidize"
    seconds: 3
    at -> pharmacology:lab-station
    reagent -> pharmacology:oxidizer
}

synthesis pharmacology:conjugate {
    title: "conjugate"
    operation: "conjugate"
    seconds: 3
    at -> pharmacology:lab-station
    reagent -> pharmacology:conjugant
}

synthesis pharmacology:cleave {
    title: "cleave"
    operation: "cleave"
    seconds: 4
    at -> pharmacology:lab-station
    reagent -> pharmacology:cleaver
}

synthesis pharmacology:graft-polar {
    title: "graft polar"
    operation: "attach"
    seconds: 4
    fragment: "polar"
    at -> pharmacology:lab-station
    reagent -> pharmacology:polar-graft
}

synthesis pharmacology:graft-charged {
    title: "graft charged"
    operation: "attach"
    seconds: 4
    fragment: "charged"
    at -> pharmacology:lab-station
    reagent -> pharmacology:charged-graft
}

synthesis pharmacology:graft-bulky {
    title: "graft bulky"
    operation: "attach"
    seconds: 4
    fragment: "bulky"
    at -> pharmacology:lab-station
    reagent -> pharmacology:bulky-graft
}

dose-route pharmacology:swallow {
    title: "swallow"
    route: "ingested"
}

dose-route pharmacology:inhale {
    title: "inhale (needs an inhaler)"
    route: "inhaled"
    needs-device -> pharmacology:inhaler
}

dose-route pharmacology:inject {
    title: "inject (uses a syringe)"
    route: "injected"
    needs-device -> pharmacology:syringe { uses: 1 }
}

starter-body pharmacology:starter {
    halves -> [pharmacology:receptor-a pharmacology:receptor-b pharmacology:receptor-c]
    enzymes -> [pharmacology:oxidase pharmacology:conjugase]
    doses -> [pharmacology:swallowed-dose pharmacology:inhaled-dose pharmacology:injected-dose]
}

receptor-half pharmacology:receptor-a {
    cells: "wall open-polar wall trigger-0 open-bulky trigger-0 wall open-charged wall open-polar wall trigger-0 wall"
}

receptor-half pharmacology:receptor-b {
    cells: "wall open-charged wall trigger-1 open-polar+bulky trigger-1 wall open-bulky wall wall open-charged wall trigger-1"
}

receptor-half pharmacology:receptor-c {
    cells: "wall open-bulky+charged wall brake open-polar wall wall open-bulky wall open-charged wall wall brake"
    expression: 0.5
}

enzyme pharmacology:oxidase { operation: oxidize, wants: "bulky+charged" }
enzyme pharmacology:conjugase { operation: conjugate, wants: "polar+charged" }

chemistry pharmacology:mist-opening { targets -> pharmacology:receptor-a, skips: brake }
chemistry pharmacology:mist-closing { targets -> pharmacology:receptor-a, skips: trigger }
chemistry pharmacology:swayer { targets -> pharmacology:receptor-b, skips: brake }
chemistry pharmacology:lifting { targets -> [pharmacology:receptor-a pharmacology:receptor-b], skips: brake }
chemistry pharmacology:dulling { targets -> pharmacology:receptor-c, skips: trigger }

starter-dose pharmacology:swallowed-dose { half -> pharmacology:receptor-a, skips: brake, route: ingested, amount: 2 }
starter-dose pharmacology:inhaled-dose { half -> pharmacology:receptor-b, skips: brake, route: inhaled, amount: 2 }
starter-dose pharmacology:injected-dose { half -> pharmacology:receptor-c, skips: trigger, route: injected, amount: 2 }

signal-drive pharmacology:mist-reveals { signal: mist, gain: 2, drives -> base:mist }
signal-drive pharmacology:tide-shows { signal: mist, gain: -2, drives -> base:tide }
signal-drive pharmacology:ember-shows { signal: mist, also: lift, gain: 1, drives -> base:ember }
signal-drive pharmacology:mist-turns { signal: mist, gain: 1.2, drives -> engine:color-turn-0 }
signal-drive pharmacology:sway-warps { signal: sway, gain: 0.15, drives -> engine:warp }
signal-drive pharmacology:sway-widens { signal: sway, gain: 0.6, drives -> engine:field-of-view }
signal-drive pharmacology:sway-lingers { signal: sway, gain: 1, drives -> engine:afterimage }
signal-drive pharmacology:lift-lightens { signal: lift, gain: -0.8, drives -> engine:gravity }
signal-drive pharmacology:lift-raises { signal: lift, gain: 0.8, drives -> engine:jump-height }
