material base:oak-leaves { living: 1 }
material base:birch-leaves { living: 1 }
material base:spruce-leaves { living: 1 }
material base:jungle-leaves { living: 1 }
material base:acacia-leaves { living: 1 }
material base:cherry-leaves { living: 1 }
material base:maple-leaves { living: 1 }
material base:willow-leaves { living: 1 }

material base:cactus {
    living: 1
    makes -> pharmacology:swayer
}

material base:fern {
    living: 1
    plant: 1
    thrives: "wet"
    makes -> pharmacology:mist-opening
}

material base:flower {
    living: 1
    plant: 1
    makes -> pharmacology:lifting
}

material base:thornbush {
    living: 1
    plant: 1
    thrives: "arid"
    makes -> pharmacology:mist-closing
}

material base:moss {
    living: 1
    plant: 1
    thrives: "cold"
    makes -> pharmacology:dulling
}

material base:mushroom-cap {
    living: 1
    makes -> pharmacology:swayer
}

material base:petals {
    living: 1
    makes -> pharmacology:lifting
}

material base:pollen {
    living: 1
    makes -> pharmacology:lifting
}

material base:sulfur { fills -> pharmacology:mutagen }

material pharmacology:collector {
    red: 170
    green: 175
    blue: 190
    grain: 0.04
    fills -> pharmacology:collector-role
}

material pharmacology:bench {
    red: 150
    green: 110
    blue: 80
    grain: 0.08
    fills -> pharmacology:bench-role
}

material pharmacology:catalog {
    red: 120
    green: 70
    blue: 45
    grain: 0.06
    fills -> pharmacology:catalog-role
}

material pharmacology:press {
    red: 130
    green: 100
    blue: 70
    grain: 0.08
}

material pharmacology:lab {
    red: 205
    green: 215
    blue: 220
    grain: 0.03
    mining-tier: 3
}

ware pharmacology:oxidizer {
    red: 230
    green: 220
    blue: 90
}

ware pharmacology:conjugant {
    red: 120
    green: 190
    blue: 120
}

ware pharmacology:cleaver {
    red: 170
    green: 90
    blue: 90
}

ware pharmacology:polar-graft {
    red: 90
    green: 150
    blue: 230
}

ware pharmacology:charged-graft {
    red: 230
    green: 120
    blue: 60
}

ware pharmacology:bulky-graft {
    red: 140
    green: 110
    blue: 90
}

ware pharmacology:inhaler {
    red: 190
    green: 210
    blue: 230
}

ware pharmacology:syringe {
    red: 220
    green: 230
    blue: 235
}

station pharmacology:press-station {
    placed-as -> pharmacology:press
}

station pharmacology:lab-station {
    placed-as -> pharmacology:lab
}

group pharmacology:leaves {
    label: "leaves"
    member -> [base:oak-leaves base:birch-leaves base:spruce-leaves base:jungle-leaves base:acacia-leaves base:cherry-leaves base:maple-leaves base:willow-leaves base:mushroom-cap base:petals]
}

group pharmacology:rubble {
    label: "gravel or lava"
    member -> [base:gravel base:lava]
}

group pharmacology:strange-stones {
    label: "strange stone"
    member -> [base:mist-stone base:mist-light base:ember-stone base:ember-light base:tide-stone base:tide-light]
}

upgrade pharmacology:assay-kit {
    title: "assay kit"
    assays: 1
}

insight pharmacology:strangeness {
    title: "strangeness"
    notice: "Blocks that only appear to an altered eye still carry charge and bulk."
    noticed-breaking -> pharmacology:strange-stones
}

insight pharmacology:meltwater {
    title: "meltwater"
    notice: "Melted ice, snow and water carry a polar graft."
    noticed-breaking -> game:waters
}

insight pharmacology:pulping {
    title: "pulping"
    notice: "A lab finds grafts in what others built: masonry crushes to a bulky graft and cloth pulps to conjugant."
    noticed-breaking -> game:built-materials
}

insight pharmacology:seen-mist {
    title: "the mist"
    notice: "While the mist signal is up, pale stones stand where there was air. They hold you once you are out of them, and they are gone again when it falls."
    noticed-revealing -> base:mist
}

insight pharmacology:seen-tide {
    title: "the tide"
    notice: "With the mist signal held below rest, teal stones show. Whatever takes the mist down shows them, a sway or the minutes after a long mist."
    noticed-revealing -> base:tide
}

insight pharmacology:seen-ember {
    title: "ember"
    notice: "With the mist up and the body lifted at once, warm red stones show. Neither alone is enough."
    noticed-revealing -> base:ember
}

insight pharmacology:rumor-lock {
    title: "a rumor: fern and thornbush"
    notice: "The fern of wet ground opens something in the eye. The thornbush of dry sand sits in the same lock and does not turn it."
    noticed-reading -> game:pamphlet
}

insight pharmacology:rumor-ash {
    title: "a rumor: ash and sulfur"
    notice: "Seeds crossed where the air is thick with ash come out stranger, and stranger still with sulfur in the pocket."
    noticed-reading -> game:pamphlet
}

insight pharmacology:rumor-tide {
    title: "a rumor: the tide"
    notice: "There are stones only a falling eye sees. Some mushrooms set you swaying hard enough to show them, and so do the minutes after a long mist has left you."
    noticed-reading -> game:pamphlet
}

insight pharmacology:rumor-ember {
    title: "a rumor: ember"
    notice: "The fern opens the mist. The flower opens it and lifts you at once, and an eye that is lifted while it sees the mist sees the ember stones too."
    noticed-reading -> game:pamphlet
}

recipe pharmacology:make-press {
    seconds: 2
    at -> game:workbench-station
    produces -> pharmacology:press
    consumes -> base:wood-planks { count: 3 }
    consumes -> game:stones { count: 3 }
}

recipe pharmacology:make-bench {
    seconds: 2
    at -> game:workbench-station
    produces -> pharmacology:bench
    consumes -> base:wood-planks { count: 3 }
    consumes -> base:glass { count: 3 }
}

recipe pharmacology:make-catalog {
    seconds: 3
    at -> game:workbench-station
    produces -> pharmacology:catalog
    consumes -> base:wood-planks { count: 9 }
    consumes -> base:glass { count: 3 }
}

recipe pharmacology:make-inhaler {
    seconds: 1.5
    at -> game:workbench-station
    produces -> pharmacology:inhaler
    consumes -> base:glass { count: 3 }
    consumes -> base:wood-planks
}

