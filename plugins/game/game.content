    at -> game:furnace-station
    produces -> game:iron-bar
    consumes -> base:iron-ore { count: 3 }
}

recipe game:make-copper-pickaxe {
    seconds: 3
    at -> game:anvil-station
    produces -> game:copper-pickaxe
    consumes -> base:wood-planks { count: 2 }
    consumes -> game:copper-bar { count: 3 }
}

recipe game:make-iron-pickaxe {
    seconds: 4
    at -> game:anvil-station
    produces -> game:iron-pickaxe
    consumes -> base:wood-planks { count: 2 }
