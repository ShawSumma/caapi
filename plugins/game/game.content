material game:beacon {
    red: 120
    green: 230
    blue: 255
    glows: 1
    fills -> game:beacon-role
}

material game:workbench {
    red: 160
    green: 120
    blue: 70
    grain: 0.08
}

material game:furnace {
    red: 95
    green: 90
    blue: 88
    grain: 0.15
    mining-tier: 1
}

material game:anvil {
    red: 70
    green: 72
    blue: 80
    grain: 0.05
    mining-tier: 1
}

material game:pamphlet {
    red: 232
    green: 224
    blue: 196
    grain: 0.04
    break-seconds: 0.3
}

ware game:copper-bar {
    red: 200
    green: 120
    blue: 70
}

ware game:iron-bar {
    red: 175
    green: 175
    blue: 180
}

ware game:charcoal {
    red: 45
    green: 40
    blue: 38
}

station game:workbench-station {
    placed-as -> game:workbench
}

station game:furnace-station {
    placed-as -> game:furnace
}

station game:anvil-station {
    placed-as -> game:anvil
}

group game:woods {
    label: "wood"
    member -> [base:oak-wood base:birch-wood base:spruce-wood base:jungle-wood base:acacia-wood base:mushroom-stem base:flower-stem]
}

group game:sands {
    label: "sand"
    member -> [base:sand base:red-sand base:sandstone base:red-sandstone]
}

group game:stones {
    label: "stone"
    member -> [base:limestone base:dolomite base:shale base:slate base:sandstone base:red-sandstone base:marble base:granite base:diorite base:andesite base:gabbro base:basalt base:olivine]
}

group game:clays {
    label: "clay"
    member -> [base:clay base:clay-loam base:mud]
}

group game:sandy-soils {
    label: "sandy soil"
    member -> [base:sandy-loam base:gravel base:dirt base:grass base:lush-grass base:coarse-grass base:tan-grass base:mud-grass base:cave-grass]
}

group game:silty-soils {
    label: "silty soil"
    member -> [base:silt base:silty-loam base:clay-loam base:mud base:dirt base:grass base:lush-grass base:coarse-grass base:tan-grass base:mud-grass base:cave-grass]
}

group game:siftable {
    label: "soil"
    member -> [base:sandy-loam base:gravel base:dirt base:silt base:silty-loam base:clay-loam base:mud base:grass base:lush-grass base:coarse-grass base:tan-grass base:mud-grass base:cave-grass]
}

group game:fine-soils {
    label: "fine soil"
    member -> [base:silt base:silty-loam base:sandy-loam]
}

group game:waters {
    label: "water or ice"
    member -> [base:snow base:ice base:ice-slush base:water]
}

group game:masonry {
    label: "masonry"
    member -> [base:grey-brick base:white-brick base:concrete base:wet-concrete base:plaster base:ceiling-tile]
}

group game:cloth {
    label: "cloth"
    member -> [base:wallpaper base:stained-wallpaper base:carpet base:damp-carpet base:red-carpet game:pamphlet]
}

group game:lamps {
    label: "lamp"
    member -> [base:light-panel base:sunlight]
}

group game:built-materials {
    label: "built material"
    member -> [base:grey-brick base:white-brick base:concrete base:wet-concrete base:plaster base:ceiling-tile base:wallpaper base:stained-wallpaper base:carpet base:damp-carpet base:red-carpet base:light-panel base:sunlight base:steel]
}

upgrade game:wooden-pickaxe {
    title: "wooden pickaxe"
    mining-tier: 1
}

upgrade game:stone-pickaxe {
    title: "stone pickaxe"
    mining-tier: 2
}

upgrade game:copper-pickaxe {
    title: "copper pickaxe"
    mining-tier: 3
}

upgrade game:iron-pickaxe {
    title: "iron pickaxe"
    mining-tier: 4
}

insight game:charring {
    title: "charring"
    notice: "Wood left in the furnace's heat turns to charcoal, and charcoal worked through ore gives back more metal."
    noticed-working -> game:furnace-station
}

insight game:sifting {
    title: "sifting"
    notice: "Loam, grass and dirt are sand and clay held together; sifted, they come apart, and the finest of them melts to glass."
    noticed-breaking -> game:siftable
}

insight game:quenching {
    title: "quenching"
    notice: "Water poured over hot sand sets more glass, and lava cools to glass."
    noticed-breaking -> game:waters
}

insight game:salvage {
    title: "salvage"
    notice: "What others built can be taken apart: masonry stacks into a furnace, cloth chars, lamps keep their glass and steel gives back its iron."
    noticed-breaking -> game:built-materials
}

insight game:rumor-quarter-turn {
    title: "a rumor: the quarter turn"
    notice: "Walk five equal lengths, turning right after each, and you stand where you began, facing the way you set out. Only the compass disagrees, by a quarter turn."
    noticed-reading -> game:pamphlet
}

insight game:rumor-panels {
    title: "a rumor: the light panels"
    notice: "The panels that light these rooms are mostly glass. A furnace would give it back."
    noticed-reading -> game:pamphlet
}

insight game:rumor-bindings {
    title: "a rumor: bound in cloth"
    notice: "Many of the books here are bound in cloth, and cloth chars in a furnace like wood."
    noticed-reading -> game:pamphlet
}

insight game:rumor-ores {
    title: "a rumor: where the ores keep"
    notice: "Copper keeps to marble and slate; iron to the hard rocks further down; sulfur to the pale layered stone near the top."
    noticed-reading -> game:pamphlet
}

insight game:rumor-charcoal {
    title: "a rumor: ore and charcoal"
    notice: "Ore smelted alone gives back less metal than ore worked with charcoal."
    noticed-reading -> game:pamphlet
}

recipe game:planks {
    seconds: 0.5
    at -> crafting:hand
    produces -> base:wood-planks { yield: 3 }
    consumes -> game:woods
}

recipe game:make-workbench {
    seconds: 1.5
    at -> crafting:hand
    produces -> game:workbench
    consumes -> base:wood-planks { count: 9 }
}

recipe game:make-wooden-pickaxe {
    seconds: 1.5
    at -> game:workbench-station
    produces -> game:wooden-pickaxe
    consumes -> base:wood-planks { count: 3 }
}

recipe game:make-stone-pickaxe {
    seconds: 2
    at -> game:workbench-station
    produces -> game:stone-pickaxe
    consumes -> base:wood-planks { count: 2 }
    consumes -> game:stones { count: 3 }
}

recipe game:make-furnace {
    seconds: 3
    at -> game:workbench-station
    produces -> game:furnace
    consumes -> game:stones { count: 9 }
}

recipe game:make-anvil {
    seconds: 3
    at -> game:workbench-station
    produces -> game:anvil
    consumes -> game:stones { count: 3 }
    consumes -> game:copper-bar { count: 3 }
}

recipe game:smelt-glass {
    at -> game:furnace-station
    produces -> base:glass
    consumes -> game:sands { count: 3 }
}

recipe game:smelt-copper {
    seconds: 2
    at -> game:furnace-station
