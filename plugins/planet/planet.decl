kind planet-void {
    until: number
    world: text
    over: text?
    look: text?
    fog: number 0.. = 3.5
}

kind planet-voids {
    layers: some -> planet-void
    everywhere: text?
}

kind planet-ground {
    tag: text
    under: "open" | "sealed"
    crust: "none" | "risen" = "none"
}

kind planet-grounds {
    grounds: some -> planet-ground
}

kind planet-fixtures {
    watch-fire: one -> material
    trail: one -> material
    cairn: one -> material
}

kind grove-materials {
    trunk: one -> material
    deck: one -> material
    step: one -> material
    rail: one -> material
    vine: one -> material
    lantern: one -> material
    chain: one -> material
    hut: one -> material
    roof: one -> material
    leaves: one -> material
}
