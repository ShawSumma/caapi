kind rooms-biome {
    wall: one -> material
    floor: one -> material
    ceiling: one -> material
    light: optional -> material
    trim: optional -> material
    damp: optional -> material
    stair: one -> material
    shelf: optional -> material
    boxes: optional -> material
    room-floors: many -> material
    uses: many -> rooms-use
    big: number 0..1 = 0.25
    open: number 0..1 = 0
    hall-doors: number 0..1 = 0.35
    box-odds: number 0..1 = 0
    skylight: number 0..1 = 0
    nowhere: number 0..1 = 0
    plans: many -> rooms-plan {
        weight: number 0..
    }
    well: number 0..1 = 0
    grandeur-above: number 0..1 = 0
    grandeur-below: number 0..1 = 1
    wetness-above: number 0..1 = 0
    wetness-below: number 0..1 = 1
    age-above: number 0..1 = 0
    age-below: number 0..1 = 1
    darkness-above: number 0..1 = 0
    darkness-below: number 0..1 = 1
    weight: number 0.. = 1
    box-height: integer 0.. = 0
    vents: "none" | "some" = "none"
}

kind rooms-hall {
    floor: one -> material
    ceiling: one -> material
    light: one -> material
    skylight: number 0..1 = 0
}

kind rooms-plan {
    plan: "rooms" | "pillars" | "pool" | "court"
    pillar-every: integer 2..8 = 4
}

kind rooms-use {
    material: one -> material
    odds: number 0..1
    height: integer 1..4 = 1
}

kind rooms-rare {
    plan: "rings" | "chapel" | "pillars" | "pool" | "court"
    one-in: integer 1.. = 27
}

kind rooms-level {
    halls: "none" | "grid" | "streets" = "none"
    hall-width: integer 0.. = 0
    room: integer 1.. = 4
    kind: "rooms" | "maze" = "rooms"
    solid: number 0..1 = 0
    missing: number 0..1 = 0
    rings: number 0..1 = 0
    chapel: number 0..1 = 0
    stairs: number 0..1 = 0
    hall: optional -> rooms-hall
    biomes: some -> rooms-biome
    rare: many -> rooms-rare
}

kind rooms-materials {
    ground: one -> connector-ground
    vent: one -> material
    roof: one -> material
    window: one -> material
    sunlight: one -> material
    mural: one -> material
    mural-line: one -> material
    water: one -> material
    lawn: one -> material
    trunk: one -> material
    leaves: one -> material
    sign: one -> material
    levels: 2.. -> rooms-level
}
