name "mined"
description "Hyperbolic voxel engine"
license "Apache-2.0"
importPaths "source"
stringImportPaths "source/shaders"

configuration "application" {
    targetType "executable"
    targetName "mined"
    mainSourceFile "source/main.d"
    sourcePaths "source"
    lflags "-l:libglfw.so.3" "-lGL"
}

configuration "unittest" {
    targetType "executable"
    targetName "mined-test"
    mainSourceFile "source/test_main.d"
    sourcePaths "source/common"
}
