name "mined"
description "Hyperbolic voxel engine"
license "Apache-2.0"
targetType "executable"
targetName "mined"
mainSourceFile "source/main.d"
sourcePaths "source"
importPaths "source"
stringImportPaths "source/shaders/spv"
dflags "-P-Ideps/SDL3/include" "-P-Ideps/Vulkan-Headers/include"
libs "vulkan" "dl"
lflags "-Ldeps/SDL3/build" "-l:libSDL3.a"

preBuildCommands "cmake -S deps/SDL3 -B deps/SDL3/build -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_VULKAN=ON -DSDL_TEST=OFF -DSDL_TESTS=OFF -DSDL_X11=ON -DSDL_WAYLAND=OFF -DSDL_X11_XCURSOR=OFF -DSDL_X11_XDBE=OFF -DSDL_X11_XFIXES=OFF -DSDL_X11_XINPUT=OFF -DSDL_X11_XRANDR=OFF -DSDL_X11_XSCRNSAVER=OFF -DSDL_X11_XSHAPE=OFF -DSDL_X11_XTEST=OFF -DSDL_HIDAPI=OFF -DSDL_AUDIO=OFF -DSDL_HAPTIC=OFF -DSDL_SENSOR=OFF -DSDL_JOYSTICK=OFF -DCMAKE_BUILD_TYPE=Release" "cmake --build deps/SDL3/build --parallel" "mkdir -p source/shaders/spv" "glslc -I source/shaders source/shaders/voxels.vert -o source/shaders/spv/voxels.vert.spv" "glslc source/shaders/voxels.frag -o source/shaders/spv/voxels.frag.spv" "glslc -I source/shaders --target-env=vulkan1.1 source/shaders/extract.comp -o source/shaders/spv/extract.comp.spv" "glslc source/shaders/fullscreen.vert -o source/shaders/spv/fullscreen.vert.spv" "glslc -I source/shaders source/shaders/fog.frag -o source/shaders/spv/fog.frag.spv" "glslc source/shaders/highlight.vert -o source/shaders/spv/highlight.vert.spv" "glslc source/shaders/highlight.frag -o source/shaders/spv/highlight.frag.spv" "glslc -I source/shaders source/shaders/worldgen.comp -o source/shaders/spv/worldgen.comp.spv" "glslc source/shaders/transforms.comp -o source/shaders/spv/transforms.comp.spv"
