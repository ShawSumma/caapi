name "mined"
description "Hyperbolic voxel engine - D port of hypermine"
license "Apache-2.0"
targetType "executable"
targetName "mined"
mainSourceFile "source/main.d"
sourcePaths "source"
importPaths "source"
stringImportPaths "source/shaders/spv"
libs "vulkan"
lflags "-L/opt/homebrew/lib" "obj/cocoa.o" "-framework" "Cocoa" "-framework" "QuartzCore"

preBuildCommands "mkdir -p obj" "clang -fobjc-arc -c source/bindings/cocoa.m -o obj/cocoa.o" "mkdir -p source/shaders/spv" "glslc source/shaders/cube.vert -o source/shaders/spv/cube.vert.spv" "glslc source/shaders/cube.frag -o source/shaders/spv/cube.frag.spv" "glslc -I source/shaders source/shaders/voxels.vert -o source/shaders/spv/voxels.vert.spv" "glslc source/shaders/voxels.frag -o source/shaders/spv/voxels.frag.spv" "glslc -I source/shaders --target-env=vulkan1.1 source/shaders/extract.comp -o source/shaders/spv/extract.comp.spv" "glslc source/shaders/fullscreen.vert -o source/shaders/spv/fullscreen.vert.spv" "glslc -I source/shaders source/shaders/fog.frag -o source/shaders/spv/fog.frag.spv"
