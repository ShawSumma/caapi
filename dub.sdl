name "mined"
description "Hyperbolic voxel engine"
license "Apache-2.0"
targetType "executable"
sourcePaths "source"
importPaths "source"
dependency "mined:api" version="*"

sourceFiles "lua/lapi.c" "lua/lcode.c" "lua/lctype.c" "lua/ldebug.c" "lua/ldo.c" "lua/ldump.c" "lua/lfunc.c" "lua/lgc.c" "lua/llex.c" "lua/lmem.c" "lua/lobject.c" "lua/lopcodes.c" "lua/lparser.c" "lua/lstate.c" "lua/lstring.c" "lua/ltable.c" "lua/ltm.c" "lua/lundump.c" "lua/lvm.c" "lua/lzio.c" "lua/lauxlib.c" "lua/lbaselib.c" "lua/lcorolib.c" "lua/ldblib.c" "lua/liolib.c" "lua/lmathlib.c" "lua/loadlib.c" "lua/loslib.c" "lua/lstrlib.c" "lua/ltablib.c" "lua/lutf8lib.c" "lua/linit.c"
dflags "-betterC" "-checkaction=halt" "-P-Ilua" "-P-DLUA_USE_LINUX" "-P-DLUA_USE_JUMPTABLE=0"
libs "dl" "m" "pthread"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :planet" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :road" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :bigtree" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :city" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :backrooms" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :tower" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :crown" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :trail" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :fixtures"

configuration "application" {
	targetName "mined"
	mainSourceFile "source/main.d"
	excludedSourceFiles "source/headless.d" "source/worldcheck.d" "source/unittests.d"
	stringImportPaths "source/shaders/spv"
	dflags "-P-Ideps/vulkan-headers/include"
	libs "vulkan" "X11" ":libXi.so.6"
	lflags "--export-dynamic"
	preBuildCommands "mkdir -p source/shaders/spv" "glslc -I source/shaders source/shaders/voxels.vert -o source/shaders/spv/voxels.vert.spv" "glslc source/shaders/voxels.frag -o source/shaders/spv/voxels.frag.spv" "glslc source/shaders/fullscreen.vert -o source/shaders/spv/fullscreen.vert.spv" "glslc -I source/shaders source/shaders/fog.frag -o source/shaders/spv/fog.frag.spv" "glslc -I source/shaders source/shaders/highlight.vert -o source/shaders/spv/highlight.vert.spv" "glslc source/shaders/highlight.frag -o source/shaders/spv/highlight.frag.spv" "glslc -I source/shaders source/shaders/cull.comp -o source/shaders/spv/cull.comp.spv" "glslc source/shaders/crosshair.vert -o source/shaders/spv/crosshair.vert.spv" "glslc source/shaders/crosshair.frag -o source/shaders/spv/crosshair.frag.spv"
}

configuration "headless" {
	targetName "mined-headless"
	mainSourceFile "source/headless.d"
	excludedSourceFiles "source/main.d" "source/unittests.d" "source/bindings/platform.c" "source/client/graphics/*" "source/client/graphics/voxels/*"
}

configuration "unittest" {
	targetName "mined-unittest"
	mainSourceFile "source/unittests.d"
	excludedSourceFiles "source/main.d" "source/headless.d" "source/worldcheck.d" "source/bindings/*" "source/client/graphics/*" "source/client/graphics/voxels/*" "source/client/lua.d" "source/client/script.d" "source/client/structures.d" "source/client/tiles.d" "lua/*"
}

subPackage {
	name "api"
	targetType "sourceLibrary"
	sourcePaths "plugins/api"
	importPaths "."
}

subPackage {
	name "turtle"
	targetType "sourceLibrary"
	sourcePaths "plugins/turtle"
	importPaths "."
	dependency "mined:api" version="*"
}

subPackage {
	name "box"
	targetType "sourceLibrary"
	sourcePaths "plugins/box"
	importPaths "."
	dependency "mined:turtle" version="*"
}

subPackage {
	name "buildings"
	targetType "sourceLibrary"
	sourcePaths "plugins/buildings"
	importPaths "."
	dependency "mined:turtle" version="*"
}

subPackage {
	name "connector"
	targetType "sourceLibrary"
	sourcePaths "plugins/connector"
	importPaths "."
	dependency "mined:turtle" version="*"
}

subPackage {
	name "blocks"
	targetType "sourceLibrary"
	sourcePaths "plugins/blocks"
	importPaths "."
	dependency "mined:buildings" version="*"
	dependency "mined:connector" version="*"
}

subPackage {
	name "rooms"
	targetType "sourceLibrary"
	sourcePaths "plugins/rooms"
	importPaths "."
	dependency "mined:blocks" version="*"
}

subPackage {
	name "skies"
	targetType "sourceLibrary"
	sourcePaths "plugins/skies"
	importPaths "."
	dependency "mined:rooms" version="*"
}

subPackage {
	name "planet"
	targetType "dynamicLibrary"
	targetPath "lib"
	sourcePaths "plugins/planet"
	importPaths "."
	dflags "-betterC" "-checkaction=halt"
	libs "m"
	dependency "mined:skies" version="*"
}

subPackage {
	name "road"
	targetType "dynamicLibrary"
	targetPath "lib"
	sourcePaths "plugins/road"
	importPaths "."
	dflags "-betterC" "-checkaction=halt"
	libs "m"
	dependency "mined:turtle" version="*"
}

subPackage {
	name "bigtree"
	targetType "dynamicLibrary"
	targetPath "lib"
	sourcePaths "plugins/bigtree"
	importPaths "."
	dflags "-betterC" "-checkaction=halt"
	libs "m"
	dependency "mined:turtle" version="*"
}

subPackage {
	name "city"
	targetType "dynamicLibrary"
	targetPath "lib"
	sourcePaths "plugins/city"
	importPaths "."
	dflags "-betterC" "-checkaction=halt"
	libs "m"
	dependency "mined:blocks" version="*"
}

subPackage {
	name "backrooms"
	targetType "dynamicLibrary"
	targetPath "lib"
	sourcePaths "plugins/backrooms"
	importPaths "."
	dflags "-betterC" "-checkaction=halt"
	libs "m"
	dependency "mined:rooms" version="*"
}

subPackage {
	name "tower"
	targetType "dynamicLibrary"
	targetPath "lib"
	sourcePaths "plugins/tower"
	importPaths "."
	dflags "-betterC" "-checkaction=halt"
	libs "m"
	dependency "mined:box" version="*"
}

subPackage {
	name "crown"
	targetType "dynamicLibrary"
	targetPath "lib"
	sourcePaths "plugins/crown"
	importPaths "."
	dflags "-betterC" "-checkaction=halt"
	libs "m"
	dependency "mined:box" version="*"
}

subPackage {
	name "trail"
	targetType "dynamicLibrary"
	targetPath "lib"
	sourcePaths "plugins/trail"
	importPaths "."
	dflags "-betterC" "-checkaction=halt"
	libs "m"
	dependency "mined:box" version="*"
