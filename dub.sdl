name "mined"
description "Hyperbolic voxel engine"
license "MIT"
targetType "executable"
sourcePaths "source"
importPaths "source"
dependency "mined:api" version="*"

dflags "-betterC" "-checkaction=halt" "--enable-asserts" "--boundscheck=on"
libs "dl" "m" "pthread"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :planet" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :road" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :city" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :backrooms" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :tower" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :crown" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :trail" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :fixtures" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :babel" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :library" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :palace" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :arbor" "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :lattice"

configuration "application" {
	targetName "mined"
	mainSourceFile "source/main.d"
	excludedSourceFiles "source/headless.d" "source/worldcheck.d" "source/unittests.d" "source/unit/*"
	stringImportPaths "source/shaders/spv"
	libs "vulkan" "X11" ":libXi.so.6" platform="linux"
	lflags "--export-dynamic" platform="linux"
	dflags "-P-I/opt/homebrew/include" platform="osx"
	libs "vulkan" "objc" platform="osx"
	lflags "-L/opt/homebrew/lib" "-framework" "AppKit" "-framework" "QuartzCore" platform="osx"
	preBuildCommands "mkdir -p source/shaders/spv" "glslc -I source/shaders source/shaders/voxels.vert -o source/shaders/spv/voxels.vert.spv" "glslc source/shaders/voxels.frag -o source/shaders/spv/voxels.frag.spv" "glslc source/shaders/fullscreen.vert -o source/shaders/spv/fullscreen.vert.spv" "glslc -I source/shaders source/shaders/fog.frag -o source/shaders/spv/fog.frag.spv" "glslc -I source/shaders source/shaders/highlight.vert -o source/shaders/spv/highlight.vert.spv" "glslc source/shaders/highlight.frag -o source/shaders/spv/highlight.frag.spv" "glslc -I source/shaders source/shaders/cull.comp -o source/shaders/spv/cull.comp.spv" "glslc source/shaders/crosshair.vert -o source/shaders/spv/crosshair.vert.spv" "glslc source/shaders/crosshair.frag -o source/shaders/spv/crosshair.frag.spv" "glslc source/shaders/hud.vert -o source/shaders/spv/hud.vert.spv" "glslc source/shaders/hud.frag -o source/shaders/spv/hud.frag.spv" "glslc -I source/shaders source/shaders/marker.vert -o source/shaders/spv/marker.vert.spv" "glslc source/shaders/marker.frag -o source/shaders/spv/marker.frag.spv"
}

configuration "headless" {
	targetName "mined-headless"
	mainSourceFile "source/headless.d"
	excludedSourceFiles "source/main.d" "source/unittests.d" "source/unit/*" "source/bindings/platform.c" "source/client/cocoa.d" "source/client/graphics/*" "source/client/graphics/voxels/*"
	lflags "--export-dynamic" platform="linux"
}

configuration "unittest" {
	targetName "mined-unittest"
	mainSourceFile "source/unittests.d"
	excludedSourceFiles "source/main.d" "source/headless.d" "source/worldcheck.d" "source/bindings/platform.c" "source/client/cocoa.d" "source/client/graphics/*" "source/client/graphics/voxels/*" "source/client/script.d" "source/client/drive.d" "source/client/structures.d" "source/client/tiles.d" "source/scripts/*"
	lflags "--export-dynamic" platform="linux"
}

subPackage {
	name "web"
	targetType "executable"
	targetName "web-build"
	targetPath "obj/web"
	sourcePaths "web/tool"
	importPaths "web/tool"
}

subPackage {
	name "webdrive"
	targetType "executable"
	targetName "web-drive"
	targetPath "obj/web"
	sourcePaths "web/drive"
	importPaths "web/drive"
}

