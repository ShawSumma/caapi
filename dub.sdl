name "caapi"
description "Hyperbolic voxel engine"
license "MIT"
targetType "executable"
sourcePaths "source"
importPaths "source"
stringImportPaths "source/fonts" "source/common"
dependency "caapi:api" version="*"

dflags "-betterC" "-checkaction=halt" "--enable-asserts" "--boundscheck=on"
libs "dl" "m" "pthread"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :base"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :box-mod"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :buildings-mod"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :connector-mod"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :blocks-mod"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :rooms-mod"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :horospheres-mod"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :planet"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :road"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :city"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :backrooms"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :tower"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :crown"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :trail"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :fixtures"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :babel"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :library"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :palace"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :arbor"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :lattice-mod"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :caves-mod"
preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE :vaults"

configuration "application" {
	targetName "caapi"
	mainSourceFile "source/main.d"
	excludedSourceFiles "source/headless.d" "source/worldcheck.d" "source/unittests.d" "source/unit/*"
	stringImportPaths "source/shaders/spv"
	libs "vulkan" "X11" ":libXi.so.6" platform="linux"
	lflags "--export-dynamic" platform="linux"
	dflags "-P-I/opt/homebrew/include" platform="osx"
	libs "vulkan" "objc" platform="osx"
	lflags "-L/opt/homebrew/lib" "-framework" "AppKit" "-framework" "QuartzCore" platform="osx"
	preBuildCommands "mkdir -p source/shaders/spv"
	preBuildCommands "glslc -I source/shaders source/shaders/voxels.vert -o source/shaders/spv/voxels.vert.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/voxels.frag -o source/shaders/spv/voxels.frag.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/fullscreen.vert -o source/shaders/spv/fullscreen.vert.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/fog.frag -o source/shaders/spv/fog.frag.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/reduce.frag -o source/shaders/spv/reduce.frag.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/post.frag -o source/shaders/spv/post.frag.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/highlight.vert -o source/shaders/spv/highlight.vert.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/highlight.frag -o source/shaders/spv/highlight.frag.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/cull.comp -o source/shaders/spv/cull.comp.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/crosshair.vert -o source/shaders/spv/crosshair.vert.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/crosshair.frag -o source/shaders/spv/crosshair.frag.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/hud.vert -o source/shaders/spv/hud.vert.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/hud.frag -o source/shaders/spv/hud.frag.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/marker.vert -o source/shaders/spv/marker.vert.spv"
	preBuildCommands "glslc -I source/shaders source/shaders/marker.frag -o source/shaders/spv/marker.frag.spv"
}

configuration "headless" {
	targetName "caapi-headless"
	mainSourceFile "source/headless.d"
	excludedSourceFiles "source/main.d" "source/unittests.d" "source/unit/*" "source/bindings/platform.c" "source/client/cocoa.d" "source/client/graphics/*" "source/client/graphics/voxels/*"
	lflags "--export-dynamic" platform="linux"
}

configuration "unittest" {
	targetName "caapi-unittest"
	mainSourceFile "source/unittests.d"
	excludedSourceFiles "source/main.d" "source/headless.d" "source/worldcheck.d" "source/bindings/platform.c" "source/client/cocoa.d" "source/client/graphics/*" "source/client/graphics/voxels/*" "source/client/script.d" "source/client/drive.d" "source/client/structures.d" "source/client/tiles.d" "source/scripts/*"
	sourceFiles "plugins/base/plugin.d"
	stringImportPaths "."
	lflags "--export-dynamic" platform="linux"
}

subPackage {
	name "web"
	targetType "none"
	dependency "caapi:webpack" version="*"
	preGenerateCommands "$DUB build -q --root=$PACKAGE_DIR --compiler=$DC --build=$DUB_BUILD_TYPE --arch=wasm32-unknown-wasi :wasm"
}

subPackage {
	name "wasm"
	targetType "executable"
	targetName "caapi"
	targetPath "obj/web"
	sourcePaths "web"
	excludedSourceFiles "web/tool/*"
	importPaths "." "source"
	stringImportPaths "source/shaders" "source/fonts" "source/common" "."
	dflags "-betterC" "-checkaction=halt" "--enable-asserts" "--boundscheck=on" "-i" "--fvisibility=hidden" "--mattr=+bulk-memory,+nontrapping-fptoint,+sign-ext,+mutable-globals,+simd128"
	lflags "--no-entry" "--stack-first" "-z" "stack-size=33554432" "--max-memory=4294901760" "--allow-undefined-file=web/imports.syms" "--export=_initialize" "--export=web_start" "--export=web_frame" "--export=web_resize" "--export=web_key_down" "--export=web_key_up" "--export=web_button" "--export=web_button_up" "--export=web_motion" "--export=web_pointer" "--export=web_capture" "--export=web_name_buffer" "--export=web_takes_keys" "--export=web_wants_lock" "--export=web_save" "--export=web_blur" "/usr/lib/wasm32-wasi/crt1-reactor.o" "-L/usr/lib/wasm32-wasi" "-lc" "-lm"
	extraDependencyFiles "web/glue.js" "web/play.js" "web/check.js" "web/shell.html" "web/imports.syms" "web/tool/pack.d" "web/tool/base64.d" "web/tool/files.d"
	postBuildCommands "$DUB run -q --root=$PACKAGE_DIR --compiler=$DC :webpack"
}

subPackage {
	name "webpack"
	targetType "executable"
	targetName "pack"
	targetPath "obj/web/tool"
	sourcePaths "web/tool"
	excludedSourceFiles "web/tool/drive.d"
	sourceFiles "source/base/array.d"
	importPaths "source" "web/tool"
	dflags "-betterC" "-checkaction=halt" "--enable-asserts" "--boundscheck=on"
}

subPackage {
	name "webdrive"
	targetType "executable"
	targetName "drive"
	targetPath "obj/web/tool"
	sourcePaths "web/tool"
	excludedSourceFiles "web/tool/pack.d"
	sourceFiles "source/base/array.d"
	importPaths "source" "web/tool"
	dflags "-betterC" "-checkaction=halt" "--enable-asserts" "--boundscheck=on"
}

